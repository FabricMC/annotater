unpick v4

#: Names the data of Entity is stored under
# These are only used in a handful of places and really shouldn't appear elsewhere in the future
group String entity_tag_names
    @scope method net.minecraft.world.entity.Entity saveAsPassenger (Lnet/minecraft/world/level/storage/ValueOutput;)Z
    @scope method net.minecraft.world.entity.Entity saveWithoutId (Lnet/minecraft/world/level/storage/ValueOutput;)V
    @scope method net.minecraft.world.entity.Entity load (Lnet/minecraft/world/level/storage/ValueInput;)V
    net.minecraft.world.entity.Entity.TAG_ID
    net.minecraft.world.entity.Entity.TAG_UUID
    net.minecraft.world.entity.Entity.TAG_PASSENGERS
    net.minecraft.world.entity.Entity.TAG_DATA
    net.minecraft.world.entity.Entity.TAG_POS
    net.minecraft.world.entity.Entity.TAG_MOTION
    net.minecraft.world.entity.Entity.TAG_ROTATION
    net.minecraft.world.entity.Entity.TAG_PORTAL_COOLDOWN
    net.minecraft.world.entity.Entity.TAG_NO_GRAVITY
    net.minecraft.world.entity.Entity.TAG_AIR
    net.minecraft.world.entity.Entity.TAG_ON_GROUND
    net.minecraft.world.entity.Entity.TAG_FALL_DISTANCE
    net.minecraft.world.entity.Entity.TAG_FIRE
    net.minecraft.world.entity.Entity.TAG_SILENT
    net.minecraft.world.entity.Entity.TAG_GLOWING
    net.minecraft.world.entity.Entity.TAG_INVULNERABLE
    net.minecraft.world.entity.Entity.TAG_INVULNERABLE_TIME
    net.minecraft.world.entity.Entity.TAG_CUSTOM_NAME

group int entity_tag_details
    @scope method net.minecraft.world.entity.Entity addTag (Ljava/lang/String;)Z
    net.minecraft.world.entity.Entity.MAX_ENTITY_TAG_COUNT

group int boarding_cooldown
    @scope method net.minecraft.world.entity.Entity removePassenger (Lnet/minecraft/world/entity/Entity;)V
    net.minecraft.world.entity.Entity.BOARDING_COOLDOWN

#: Numbers that represent at which digit of a binary number the data is stored
# Annotated with net.minecraft.world.entity.Entity.Flags
group int entity_property_flags
    @scope method net.minecraft.world.entity.Entity isOnFire ()Z
    @scope method net.minecraft.world.entity.Entity isShiftKeyDown ()Z
    @scope method net.minecraft.world.entity.Entity isSprinting ()Z
    @scope method net.minecraft.world.entity.Entity isSwimming ()Z
    @scope method net.minecraft.world.entity.Entity isInvisible ()Z
    @scope method net.minecraft.world.entity.Entity isCurrentlyGlowing ()Z
    net.minecraft.world.entity.Entity.FLAG_ONFIRE
    net.minecraft.world.entity.Entity.FLAG_SHIFT_KEY_DOWN
    net.minecraft.world.entity.Entity.FLAG_SPRINTING
    net.minecraft.world.entity.Entity.FLAG_SWIMMING
    net.minecraft.world.entity.Entity.FLAG_INVISIBLE
    net.minecraft.world.entity.Entity.FLAG_GLOWING

group int invalid_entity_id
    @scope method net.minecraft.world.entity.Entity getId ()I
    net.minecraft.world.entity.Entity.INVALID_ENTITY_ID

group int iterations
    @scope method net.minecraft.world.entity.Entity checkInsideBlocks (Ljava/util/List;Lnet/minecraft/world/entity/InsideBlockEffectApplier$StepBasedCollector;)V
    net.minecraft.world.entity.Entity.MAX_BLOCK_ITERATIONS_ALONG_TRAVEL_PER_TICK

target_method com.mojang.serialization.Codec sizeLimitedListOf (I)Lcom/mojang/serialization/Codec;
    param 0 entity_tag_details
