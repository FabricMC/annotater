unpick v4

# Ticks Per Second
group float
   @scope method net.minecraft.client.gui.Hud extractOverlayMessage (Lnet/minecraft/client/gui/GuiGraphicsExtractor;Lnet/minecraft/client/DeltaTracker;)V
   net.minecraft.SharedConstants.TICKS_PER_SECOND
group int
   @scope method net.minecraft.client.gui.Hud extractEffects (Lnet/minecraft/client/gui/GuiGraphicsExtractor;Lnet/minecraft/client/DeltaTracker;)V
   @scope method net.minecraft.commands.arguments.TimeArgument <clinit> ()V
   net.minecraft.SharedConstants.TICKS_PER_SECOND
group int
   @scope method net.minecraft.server.level.DemoMode tick ()V
   net.minecraft.SharedConstants.TICKS_PER_SECOND
   net.minecraft.SharedConstants.TICKS_PER_SECOND * 25

# Ticks Per Minute
group int
   @scope method net.minecraft.client.sounds.MusicManager$MusicFrequency <init> (Ljava/lang/String;ILjava/lang/String;Ljava/lang/String;I)V
   @scope method net.minecraft.world.entity.projectile.arrow.AbstractArrow tickDespawn ()V
   net.minecraft.SharedConstants.TICKS_PER_MINUTE
group int
   @scope method net.minecraft.world.entity.projectile.FishingHook catchingFish (Lnet/minecraft/core/BlockPos;)V
   net.minecraft.SharedConstants.TICKS_PER_SECOND * 30
group int
   @scope method net.minecraft.world.level.levelgen.PatrolSpawner tick (Lnet/minecraft/server/level/ServerLevel;Z)V
   net.minecraft.SharedConstants.TICKS_PER_MINUTE
   net.minecraft.SharedConstants.TICKS_PER_MINUTE * 10
group int
   @scope method net.minecraft.world.entity.animal.goat.GoatAi <clinit> ()V
   net.minecraft.SharedConstants.TICKS_PER_MINUTE
   net.minecraft.SharedConstants.TICKS_PER_SECOND * 30
   net.minecraft.SharedConstants.TICKS_PER_MINUTE * 5

# Ticks Per Game Day
group int
   @scope method net.minecraft.commands.arguments.TimeArgument <clinit> ()V
   @scope method net.minecraft.server.level.ServerLevel <clinit> ()V
   @scope method net.minecraft.util.datafix.fixes.LevelDatToSavedDataPreparationFix fixWanderingTrader (Lcom/mojang/serialization/Dynamic;)Lcom/mojang/serialization/Dynamic;
   @scope method net.minecraft.world.level.levelgen.PhantomSpawner tick (Lnet/minecraft/server/level/ServerLevel;Z)V
   @scope method net.minecraft.world.timeline.Timelines bootstrap (Lnet/minecraft/data/worldgen/BootstrapContext;)V
   net.minecraft.SharedConstants.TICKS_PER_GAME_DAY
   net.minecraft.SharedConstants.TICKS_PER_GAME_DAY / 2
   net.minecraft.SharedConstants.TICKS_PER_GAME_DAY * 3
group long
   @scope class net.minecraft.server.level.DemoMode
   @scope method net.minecraft.client.renderer.GlobalSettingsUniform update (IIDJFILnet/minecraft/world/phys/Vec3;Z)V
   net.minecraft.SharedConstants.TICKS_PER_GAME_DAY

# Methods taking tick durations
group int set_walk_target_from_block_memory_unreachable_duration
   net.minecraft.SharedConstants.TICKS_PER_MINUTE
   net.minecraft.SharedConstants.TICKS_PER_SECOND * 10
target_method net.minecraft.world.entity.ai.behavior.SetWalkTargetFromBlockMemory create (Lnet/minecraft/world/entity/ai/memory/MemoryModuleType;FIII)Lnet/minecraft/world/entity/ai/behavior/OneShot;
   param 4 set_walk_target_from_block_memory_unreachable_duration
group int mob_effect_instance_duration
   net.minecraft.SharedConstants.TICKS_PER_SECOND / 2
   net.minecraft.SharedConstants.TICKS_PER_SECOND
   net.minecraft.SharedConstants.TICKS_PER_SECOND * 2
   net.minecraft.SharedConstants.TICKS_PER_SECOND * 5
   net.minecraft.SharedConstants.TICKS_PER_SECOND * 10
   net.minecraft.SharedConstants.TICKS_PER_SECOND * 15
   net.minecraft.SharedConstants.TICKS_PER_SECOND * 20
   net.minecraft.SharedConstants.TICKS_PER_SECOND * 30
   net.minecraft.SharedConstants.TICKS_PER_SECOND * 40
   net.minecraft.SharedConstants.TICKS_PER_SECOND * 45
   net.minecraft.SharedConstants.TICKS_PER_MINUTE
   net.minecraft.SharedConstants.TICKS_PER_MINUTE * 2
   net.minecraft.SharedConstants.TICKS_PER_MINUTE * 5
target_method net.minecraft.world.effect.MobEffectInstance <init> (Lnet/minecraft/core/Holder;II)V
   param 1 mob_effect_instance_duration

# Miscellaneous Related Classes

group int
   @scope class net.minecraft.world.level.block.SnifferEggBlock
   net.minecraft.world.level.block.SnifferEggBlock.REGULAR_HATCH_TIME_TICKS
   net.minecraft.world.level.block.SnifferEggBlock.BOOSTED_HATCH_TIME_TICKS
   net.minecraft.world.level.block.SnifferEggBlock.RANDOM_HATCH_OFFSET_TICKS

group int
   @scope class net.minecraft.world.level.MoonPhase
   net.minecraft.world.level.MoonPhase.PHASE_LENGTH

group int
   @scope class net.minecraft.world.entity.npc.wanderingtrader.WanderingTraderSpawner
   net.minecraft.world.entity.npc.wanderingtrader.WanderingTraderSpawner.DEFAULT_TICK_DELAY
   net.minecraft.world.entity.npc.wanderingtrader.WanderingTraderSpawner.DEFAULT_SPAWN_DELAY
group int
   @scope class net.minecraft.world.level.saveddata.WanderingTraderData
   net.minecraft.world.entity.npc.wanderingtrader.WanderingTraderSpawner.DEFAULT_TICK_DELAY
   net.minecraft.world.entity.npc.wanderingtrader.WanderingTraderSpawner.DEFAULT_SPAWN_DELAY
   net.minecraft.world.entity.npc.wanderingtrader.WanderingTraderSpawner.MIN_SPAWN_CHANCE

group int
   @scope method net.minecraft.client.tutorial.CraftPlanksTutorialStep tick ()V
   net.minecraft.client.tutorial.CraftPlanksTutorialStep.HINT_DELAY

group int
   @scope method net.minecraft.world.entity.ai.behavior.CrossbowAttack <init> ()V
   net.minecraft.world.entity.ai.behavior.CrossbowAttack.TIMEOUT

group int
   @scope method net.minecraft.world.entity.ai.behavior.GoToPotentialJobSite <init> (F)V
   net.minecraft.world.entity.ai.behavior.GoToPotentialJobSite.TICKS_UNTIL_TIMEOUT

group int
   @scope method net.minecraft.world.entity.ai.goal.MoveToBlockGoal canContinueToUse ()Z
   net.minecraft.world.entity.ai.goal.MoveToBlockGoal.GIVE_UP_TICKS
group int
   @scope method net.minecraft.world.entity.ai.goal.MoveToBlockGoal start ()V
   net.minecraft.world.entity.ai.goal.MoveToBlockGoal.STAY_TICKS
group int
   @scope method net.minecraft.world.entity.ai.goal.MoveToBlockGoal nextStartTick (Lnet/minecraft/world/entity/PathfinderMob;)I
   net.minecraft.world.entity.ai.goal.MoveToBlockGoal.INTERVAL_TICKS

# Axolotl
group int
   @scope method net.minecraft.world.entity.animal.axolotl.Axolotl useRareVariant (Lnet/minecraft/util/RandomSource;)Z
   net.minecraft.world.entity.animal.axolotl.Axolotl.RARE_VARIANT_CHANCE
group int
   @scope method net.minecraft.world.entity.animal.axolotl.Axolotl getMaxAirSupply ()I
   net.minecraft.world.entity.animal.axolotl.Axolotl.AXOLOTL_TOTAL_AIR_SUPPLY
group int
   @scope method net.minecraft.world.entity.animal.axolotl.Axolotl rehydrate ()V
   net.minecraft.world.entity.animal.axolotl.Axolotl.REHYDRATE_AIR_SUPPLY
group int
   @scope method net.minecraft.world.entity.animal.axolotl.Axolotl applySupportingEffects (Lnet/minecraft/world/entity/player/Player;)V
   net.minecraft.world.entity.animal.axolotl.Axolotl.REGEN_BUFF_MAX_DURATION
   net.minecraft.world.entity.animal.axolotl.Axolotl.REGEN_BUFF_BASE_DURATION
group int
   @scope method net.minecraft.world.entity.animal.axolotl.Axolotl hurtServer (Lnet/minecraft/server/level/ServerLevel;Lnet/minecraft/world/damagesource/DamageSource;F)Z
   net.minecraft.world.entity.animal.axolotl.Axolotl.TOTAL_PLAYDEAD_TIME
group int
   @scope method net.minecraft.world.entity.animal.axolotl.Axolotl <clinit> ()V
   net.minecraft.world.entity.animal.axolotl.Axolotl.POSE_ANIMATION_TICKS
group int
   @scope method net.minecraft.world.entity.animal.axolotl.Axolotl finalizeSpawn (Lnet/minecraft/world/level/ServerLevelAccessor;Lnet/minecraft/world/DifficultyInstance;Lnet/minecraft/world/entity/EntitySpawnReason;Lnet/minecraft/world/entity/SpawnGroupData;)Lnet/minecraft/world/entity/SpawnGroupData;
   -net.minecraft.SharedConstants.TICKS_PER_GAME_DAY

