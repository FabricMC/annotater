   @scope package net.minecraft.client.model.animal.dolphin
   @scope package net.minecraft.client.model.animal.equine
   @scope package net.minecraft.client.model.animal.feline
   @scope package net.minecraft.client.model.animal.fish
   @scope package net.minecraft.client.model.animal.fox
