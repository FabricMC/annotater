unpick v4

# Note: using global with package scopes so we can catch things like Set.of calls
# This does, however, mean that certain specific part names that conflict with generic
# ones aren't included, and will instead use the (identical) generic PartNames versions.
# Specifically, BeeModel.BONE and SnowGolemModel.UPPER_BODY

# TODO: make a task to autogenerate this, otherwise maintaining will be a headache
#: Generic model part names
group String
   @scope package net.minecraft.client.model
   @scope package net.minecraft.client.model.ambient
   @scope package net.minecraft.client.model.animal
   @scope package net.minecraft.client.model.animal.allay
   @scope package net.minecraft.client.model.animal.armadillo
