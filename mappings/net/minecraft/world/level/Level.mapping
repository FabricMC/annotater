CLASS net/minecraft/world/level/Level
	METHOD addParticle (Lnet/minecraft/core/particles/ParticleOptions;ZZDDDDDD)V
		COMMENT Adds a particle to the client's level renderer.
		COMMENT
		COMMENT Does nothing on the server.
		COMMENT 
		COMMENT @param overrideLimiter if `true`, displays this particle even if the particle limit has been reached
		COMMENT @param alwaysShow whether to display this particle when the [particles][net.minecraft.client.Options#particles()] graphics option is set to Minimal
	METHOD explode (Lnet/minecraft/world/entity/Entity;DDDFLnet/minecraft/world/level/Level$ExplosionInteraction;)V
		COMMENT Creates an explosion.
		COMMENT 
		COMMENT @see #explode(net.minecraft.world.entity.Entity, net.minecraft.world.damagesource.DamageSource, net.minecraft.world.level.ExplosionDamageCalculator, double, double, double, float, boolean, net.minecraft.world.level.Level.ExplosionInteraction, net.minecraft.core.particles.ParticleOptions, net.minecraft.core.particles.ParticleOptions, net.minecraft.util.random.WeightedList, net.minecraft.core.Holder)
	METHOD explode (Lnet/minecraft/world/entity/Entity;DDDFZLnet/minecraft/world/level/Level$ExplosionInteraction;)V
		COMMENT Creates an explosion.
		COMMENT 
		COMMENT @see #explode(net.minecraft.world.entity.Entity, net.minecraft.world.damagesource.DamageSource, net.minecraft.world.level.ExplosionDamageCalculator, double, double, double, float, boolean, net.minecraft.world.level.Level.ExplosionInteraction, net.minecraft.core.particles.ParticleOptions, net.minecraft.core.particles.ParticleOptions, net.minecraft.util.random.WeightedList, net.minecraft.core.Holder)
	METHOD explode (Lnet/minecraft/world/entity/Entity;Lnet/minecraft/world/damagesource/DamageSource;Lnet/minecraft/world/level/ExplosionDamageCalculator;DDDFZLnet/minecraft/world/level/Level$ExplosionInteraction;)V
		COMMENT Creates an explosion.
		COMMENT 
		COMMENT @see #explode(net.minecraft.world.entity.Entity, net.minecraft.world.damagesource.DamageSource, net.minecraft.world.level.ExplosionDamageCalculator, double, double, double, float, boolean, net.minecraft.world.level.Level.ExplosionInteraction, net.minecraft.core.particles.ParticleOptions, net.minecraft.core.particles.ParticleOptions, net.minecraft.util.random.WeightedList, net.minecraft.core.Holder)
	METHOD explode (Lnet/minecraft/world/entity/Entity;Lnet/minecraft/world/damagesource/DamageSource;Lnet/minecraft/world/level/ExplosionDamageCalculator;DDDFZLnet/minecraft/world/level/Level$ExplosionInteraction;Lnet/minecraft/core/particles/ParticleOptions;Lnet/minecraft/core/particles/ParticleOptions;Lnet/minecraft/util/random/WeightedList;Lnet/minecraft/core/Holder;)V
		COMMENT  Creates an explosion.
		COMMENT 
		COMMENT  @param source the entity that exploded (like TNT) or `null` to indicate no entity exploded
		COMMENT  @param damageSource the custom damage source or `null` to use the default [net.minecraft.world.damagesource.DamageSources#explosion(net.minecraft.world.level.Explosion)]
		COMMENT  @param r the radius, or power, of the explosion
		COMMENT  @param fire whether the explosion should create fire
		COMMENT  @param interactionType the [net.minecraft.world.level.Level.ExplosionInteraction], which indicates how it should interact with the level
	METHOD explode (Lnet/minecraft/world/entity/Entity;Lnet/minecraft/world/damagesource/DamageSource;Lnet/minecraft/world/level/ExplosionDamageCalculator;Lnet/minecraft/world/phys/Vec3;FZLnet/minecraft/world/level/Level$ExplosionInteraction;)V
		COMMENT Creates an explosion.
		COMMENT 
		COMMENT @see #explode(net.minecraft.world.entity.Entity, net.minecraft.world.damagesource.DamageSource, net.minecraft.world.level.ExplosionDamageCalculator, double, double, double, float, boolean, net.minecraft.world.level.Level.ExplosionInteraction, net.minecraft.core.particles.ParticleOptions, net.minecraft.core.particles.ParticleOptions, net.minecraft.util.random.WeightedList, net.minecraft.core.Holder)
	METHOD getBlockEntity (Lnet/minecraft/core/BlockPos;)Lnet/minecraft/world/level/block/entity/BlockEntity;
		COMMENT {@return the block entity at the given position, or null if there is none}
		COMMENT 
		COMMENT This method will load the chunk containing `pos` if it's not already loaded.
		COMMENT 
		COMMENT On the server, this method will always return `null` when called off the main server thread.
	METHOD getChunkAt (Lnet/minecraft/core/BlockPos;)Lnet/minecraft/world/level/chunk/LevelChunk;
		COMMENT {@return the [net.minecraft.world.level.chunk.LevelChunk] at the given `pos`}
		COMMENT 
		COMMENT The chunk will be loaded if it isn't already.
	METHOD getEntity (I)Lnet/minecraft/world/entity/Entity;
		COMMENT {@return the entity using the entity ID, or `null` if none was found}
		COMMENT 
		COMMENT @apiNote 
		COMMENT Entity ID is ephemeral and changes after server restart. Use the UUID for persistent storage instead.
		COMMENT 
		COMMENT @see #getEntity(java.util.UUID)
	METHOD getRainLevel (F)F
		COMMENT {@return the rain level.}
		COMMENT 
		COMMENT @param a a delta value representing tick progress
	METHOD getThunderLevel (F)F
		COMMENT {@return the thunder level.}
		COMMENT 
		COMMENT @param a a delta value representing tick progress
	METHOD hasEntities (Lnet/minecraft/world/level/entity/EntityTypeTest;Lnet/minecraft/world/phys/AABB;Ljava/util/function/Predicate;)Z
		COMMENT Checks if entities of the given `type` exist in `bb`.
		COMMENT 
		COMMENT This has the same performance cost as [`getEntities`][#getEntities(net.minecraft.world.level.entity.EntityTypeTest, net.minecraft.world.phys.AABB, java.util.function.Predicate, java.util.List, int)] with `maxResults` set to 1.
	METHOD isDebug ()Z
		COMMENT Checks if this level is a debug level.
		COMMENT 
		COMMENT Debug levels are not modifiable. They have a barrier layer at y=60,
		COMMENT and lists all possible block states in game at y=70, helpful for finding
		COMMENT block rendering and model errors.
		COMMENT 
		COMMENT @see net.minecraft.world.level.levelgen.DebugLevelSource
	METHOD isInSpawnableBounds (Lnet/minecraft/core/BlockPos;)Z
		COMMENT {@return whether the `pos` is in spawnable bounds}
		COMMENT 
		COMMENT @implNote 
		COMMENT A position is considered to be inside spawnable bounds if its X and Z
		COMMENT coordinates are greater than or equal to -[#MAX_LEVEL_SIZE] and less
		COMMENT than [#MAX_LEVEL_SIZE], and its Y coordinate is greater than or equal
		COMMENT to [#MIN_ENTITY_SPAWN_Y] and less than [#MAX_ENTITY_SPAWN_Y].
		COMMENT 
		COMMENT @apiNote
		COMMENT This method should be used for spawning and teleportation. To test for
		COMMENT block positions, use [#isInWorldBounds] (which checks the height limit),
		COMMENT and if the action involves an entity interaction, additionally check for
		COMMENT [#mayInteract] (which checks the spawn protection and world border).
		COMMENT 
		COMMENT @see #isInWorldBounds
		COMMENT @see #mayInteract
	METHOD isInWorldBounds (Lnet/minecraft/core/BlockPos;)Z
		COMMENT {@return whether the `pos` is in world bounds}
		COMMENT 
		COMMENT @implNote 
		COMMENT In addition to the height limit, the position's X and Z 
		COMMENT must be greater than or equal to -[#MAX_LEVEL_SIZE] and 
		COMMENT less than [#MAX_LEVEL_SIZE].
		COMMENT 
		COMMENT @apiNote
		COMMENT This method should be used for block placement. If the 
		COMMENT action involves an entity interaction, additionally check 
		COMMENT for [#mayInteract] (which checks the spawn protection and world border).
		COMMENT 
		COMMENT @param pos the pos to check
		COMMENT 
		COMMENT @see #isInSpawnableBounds
		COMMENT @see #mayInteract
	METHOD mayInteract (Lnet/minecraft/world/entity/Entity;Lnet/minecraft/core/BlockPos;)Z
		COMMENT {@return whether `entity` can modify blocks at `pos`}
		COMMENT 
		COMMENT @implNote
		COMMENT For players, this checks the spawn protection and world border. This
		COMMENT is always `true` on the client and for non-player entites.
		COMMENT 
		COMMENT @see #isInWorldBounds
		COMMENT @see #isInSpawnableBounds
	METHOD playSeededSound (Lnet/minecraft/world/entity/Entity;DDDLnet/minecraft/core/Holder;Lnet/minecraft/sounds/SoundSource;FFJ)V
		COMMENT Plays a sound.
		COMMENT 
		COMMENT On the client, the sound will only play if `except` matches the client's player. On the server, sound packets will be sent to players around `except`, but not to `except` itself.
		COMMENT 
		COMMENT @param except the player that will play this sound (client) or be skipped (server), or `null`
		COMMENT @param source the source of the sound, which dictates which sound slider it corresponds to
	METHOD playSeededSound (Lnet/minecraft/world/entity/Entity;DDDLnet/minecraft/sounds/SoundEvent;Lnet/minecraft/sounds/SoundSource;FFJ)V
		COMMENT Plays a sound.
		COMMENT 
		COMMENT @see #playSeededSound(net.minecraft.world.entity.Entity, double, double, double, net.minecraft.core.Holder, net.minecraft.sounds.SoundSource, float, float, long)
	METHOD playSeededSound (Lnet/minecraft/world/entity/Entity;Lnet/minecraft/world/entity/Entity;Lnet/minecraft/core/Holder;Lnet/minecraft/sounds/SoundSource;FFJ)V
		COMMENT Plays a sound from `sourceEntity`'s position.
		COMMENT 
		COMMENT On the client, the sound will only play if `except` matches the client's player. On the server, sound packets will be sent to players around `except`, but not to `except` itself.
		COMMENT 
		COMMENT @param except the player that will play this sound (client) or be skipped (server), or `null`
		COMMENT @param source the source of the sound, which dictates which sound slider it corresponds to
	METHOD playSound (Lnet/minecraft/world/entity/Entity;DDDLnet/minecraft/core/Holder;Lnet/minecraft/sounds/SoundSource;FF)V
		COMMENT Plays a sound.
		COMMENT 
		COMMENT @see #playSeededSound(net.minecraft.world.entity.Entity, double, double, double, net.minecraft.core.Holder, net.minecraft.sounds.SoundSource, float, float, long)
	METHOD playSound (Lnet/minecraft/world/entity/Entity;DDDLnet/minecraft/sounds/SoundEvent;Lnet/minecraft/sounds/SoundSource;)V
		COMMENT Plays a sound.
		COMMENT 
		COMMENT @see #playSeededSound(net.minecraft.world.entity.Entity, double, double, double, net.minecraft.core.Holder, net.minecraft.sounds.SoundSource, float, float, long)
	METHOD playSound (Lnet/minecraft/world/entity/Entity;DDDLnet/minecraft/sounds/SoundEvent;Lnet/minecraft/sounds/SoundSource;FF)V
		COMMENT Plays a sound.
		COMMENT 
		COMMENT @see #playSeededSound(net.minecraft.world.entity.Entity, double, double, double, net.minecraft.core.Holder, net.minecraft.sounds.SoundSource, float, float, long)
	METHOD playSound (Lnet/minecraft/world/entity/Entity;Lnet/minecraft/core/BlockPos;Lnet/minecraft/sounds/SoundEvent;Lnet/minecraft/sounds/SoundSource;FF)V
		COMMENT Plays a sound.
		COMMENT 
		COMMENT On the client, the sound will only play if `except` matches the client's player. On the server, sound packets will be sent to players around `except`, but not to `except` itself.
		COMMENT 
		COMMENT @param except the player that will play this sound (client) or be skipped (server), or `null`
		COMMENT @param source the source of the sound, which dictates which sound slider it corresponds to
	METHOD playSound (Lnet/minecraft/world/entity/Entity;Lnet/minecraft/world/entity/Entity;Lnet/minecraft/core/Holder;Lnet/minecraft/sounds/SoundSource;FF)V
		COMMENT Plays a sound from `sourceEntity`'s position.
		COMMENT 
		COMMENT @see #playSeededSound(net.minecraft.world.entity.Entity, net.minecraft.world.entity.Entity, net.minecraft.core.Holder, net.minecraft.sounds.SoundSource, float, float, long)
	METHOD playSound (Lnet/minecraft/world/entity/Entity;Lnet/minecraft/world/entity/Entity;Lnet/minecraft/sounds/SoundEvent;Lnet/minecraft/sounds/SoundSource;FF)V
		COMMENT Plays a sound from `sourceEntity`'s position.
		COMMENT 
		COMMENT @see #playSeededSound(net.minecraft.world.entity.Entity, net.minecraft.world.entity.Entity, net.minecraft.core.Holder, net.minecraft.sounds.SoundSource, float, float, long)
	METHOD sendPacketToServer (Lnet/minecraft/network/protocol/Packet;)V
		COMMENT Sends a packet to the server.
		COMMENT 
		COMMENT @throws UnsupportedOperationException if called on the server
	CLASS ExplosionInteraction
		COMMENT Controls how an explosion interacts with the level.
		FIELD BLOCK Lnet/minecraft/world/level/Level$ExplosionInteraction;
			COMMENT Blocks are destroyed and decay according to [net.minecraft.world.level.gamerules.GameRules#BLOCK_EXPLOSION_DROP_DECAY]. Used by blocks like end crystals and respawn anchors.
		FIELD MOB Lnet/minecraft/world/level/Level$ExplosionInteraction;
			COMMENT Blocks will only be destroyes if [net.minecraft.world.level.gamerules.GameRules#MOB_GRIEFING] is `true` and will decay according to [net.minecraft.world.level.gamerules.GameRules#MOB_EXPLOSION_DROP_DECAY]. Used by mobs like creepers and the wither.
		FIELD NONE Lnet/minecraft/world/level/Level$ExplosionInteraction;
			COMMENT Blocks aren't destroyed.
		FIELD TNT Lnet/minecraft/world/level/Level$ExplosionInteraction;
			COMMENT Blocks will be destroyed and will decay according to [net.minecraft.world.level.gamerules.GameRules#TNT_EXPLOSION_DROP_DECAY]. Used by TNT.
		FIELD TRIGGER Lnet/minecraft/world/level/Level$ExplosionInteraction;
			COMMENT Blocks are triggered instead of being destroyed. Triggering will pull levers, push buttons, ring bells, extinguish candles, and open or close doors, trapdoors, and fence gates. Used by wind charges.
